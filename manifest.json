{
  "manifest_version": 3,
  "name": "Portal Sekolah Account Switcher",
  "version": "1.2.0",
  "description": "Ganti akun testing Portal Sekolah tanpa logout. Login dari extension, refresh token otomatis.",
  "action": {
    "default_title": "Portal Sekolah Account Switcher",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["cookies", "storage", "scripting", "tabs", "alarms"],
  "host_permissions": [
    "http://localhost/*",
    "https://localhost/*",
    "http://127.0.0.1/*",
    "https://127.0.0.1/*",
    "*://*.portal-sekolah.com/*",
    "*://portal-sekolah.com/*",
    "*://*.portalsekolah.com/*",
    "*://portalsekolah.com/*"
  ]
}
